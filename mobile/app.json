{
  "expo": {
    "name": "Lingua AI Tutor",
    "slug": "lingua-ai-tutor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linguaaitutor.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lingua uses your microphone so you can practice speaking and get pronunciation feedback."
      }
    },
    "android": {
      "package": "com.linguaaitutor.app",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000"
    }
  }
}
